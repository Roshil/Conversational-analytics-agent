[
  {
    "name": "customer_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Surrogate customer identifier, format CUS000001."
  },
  {
    "name": "email",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Synthetic contact email (always @example.com). Treated as PII: never send to the LLM or logs."
  },
  {
    "name": "region",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Customer home region; used for regional sales and tax."
  },
  {
    "name": "country_code",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "ISO 3166-1 alpha-2 country code."
  },
  {
    "name": "customer_segment",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Commercial segment."
  },
  {
    "name": "signup_date",
    "type": "DATE",
    "mode": "REQUIRED",
    "description": "Date the account was created (UTC). Must be on or before every order date for this customer."
  },
  {
    "name": "created_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "Record creation timestamp (UTC)."
  }
]
